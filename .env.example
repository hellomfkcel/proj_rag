# ══════════════════════════════════════════════════════════════════
# RAG 系统环境变量模板
# 复制为 .env 后按环境修改。生产环境应从 Vault / K8s Secret / 环境注入
# 获取密钥，不写入此文件。
# ══════════════════════════════════════════════════════════════════

# ── 基础设施（docker-compose.infra.yml 使用） ───────────────────────
POSTGRES_PASSWORD=<CHANGE_ME>
REDIS_PASSWORD=<CHANGE_ME>
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── LLM / Embedding 模型 ────────────────────────────────────────────
# 模型配置（model_name/base_url/provider/is_default）由 model_registry 表管理
# （管理台 → 设置 → 模型管理）。以下 .env 变量承担两职：
#   1. 首次启动 seed 的种子值；2. api_key 的秘钥兜底（DB 中该模型 api_key 为空时回落）。
# LLM key 轮换：改 LLM_API_KEY + 重启 retrieval worker 即生效（前提 DB 中该模型未设 key）。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat        # model_registry 的 model_id（DB 映射 model_name）
LLM_API_KEY=<CHANGE_ME>
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.1

# BGE-M3 嵌入 + 重排 HTTP 服务（Layer 3 服务化，共享 GPU 模型实例）
# 不设置 → worker 各自本地加载模型
EMBEDDING_SERVICE_URL=http://localhost:19500
# Infinity serving（纯稠密 embed / rerank 的托管模型名取自 model_registry 默认行）
INFINITY_URL=http://localhost:19501
# embedding 类模型的 base_url/model 兜底（本地 Ollama 嵌入备选）
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b

# ── 权限服务（Cerbos / 外部权限平台） ────────────────────────────────
# 权限判定模式：local（直连 Cerbos PDP）| remote（调外部权限服务后端）
AUTHZ_SERVICE_MODE=remote
AUTHZ_BASE_URL=http://localhost:13592        # Cerbos PDP（local 模式）
AUTHZ_SERVICE_URL=http://127.0.0.1:18080     # 外部权限服务后端（remote 模式）
AUTHZ_TIMEOUT_MS=2000
AUTHZ_PROJECT_ID=rag-v14                      # RAG 在权限平台的项目 ID
AUTHZ_CLIENT_CREDENTIAL=<CHANGE_ME>           # 权限平台为该项目签发的 service api key
# 权限服务事件流 Redis（visibility_changed 频道所在实例）。
# 注意：这是权限系统独立的 perm-redis（宿主 16380），不是 RAG 的 redis(16379)，
# 密码必须填权限系统 docker-compose 里 perm-redis 的密码（非 ${REDIS_PASSWORD}）。
AUTHZ_EVENT_STREAM_REDIS_URL=redis://:CHANGE_ME_PERM_REDIS_PASSWORD@localhost:16380/0

# ── JWT ──────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./config/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./config/jwt_public.pem
JWT_ALGORITHM=RS256
JWT_EXPIRE_SECONDS=3600

# ── IdP（Keycloak 密码授权登录；生产 SSO 用下方 OIDC 配置） ───────────
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=rag-v14
KEYCLOAK_CLIENT_ID=rag-frontend
# 生产环境从 IdP JWKS 自动取公钥（取代本地 PEM）
# JWT_JWKS_URL=https://keycloak.example.com/realms/rag/protocol/openid-connect/certs

# ── OIDC 认证（不配置时自动退回 /dev-login 开发模式） ─────────────────
# OIDC_DISCOVERY_URL=https://keycloak.example.com/realms/rag/.well-known/openid-configuration
# OIDC_CLIENT_ID=rag-v14
# OIDC_CLIENT_SECRET=<CHANGE_ME>

# ── CORS 允许来源（逗号分隔，生产配置为具体域名） ────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# ── 统一可观测平台（OTel / Langfuse） ────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=INFO
LANGFUSE_PUBLIC_KEY=<CHANGE_ME>
LANGFUSE_SECRET_KEY=<CHANGE_ME>
LANGFUSE_HOST=http://localhost:13000
LANGFUSE_PUBLIC_URL=http://localhost:13000

# ── 前端外部链接（浏览器可达地址，生产配置为域名/公网 IP） ────────────
GRAFANA_URL=http://localhost:3000
CERBOS_PUBLIC_URL=http://localhost:13592
ADMIN_CONSOLE_URL=http://localhost:3002

# ── 本地开发：基础设施连接地址 ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rag:${POSTGRES_PASSWORD}@localhost:25432/rag
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:16379/0
MILVUS_HOST=localhost
MILVUS_PORT=19530
S3_ENDPOINT_URL=http://localhost:18333
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-files
PIPELINE_YAML_DIR=./pipelines
