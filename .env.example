# ── 数据库 ───────────────────────────────────────────────────────────
POSTGRES_PASSWORD=<CHANGE_ME>

# ── Redis ────────────────────────────────────────────────────────────
REDIS_PASSWORD=<CHANGE_ME>

# ── 对象存储（SeaweedFS S3 网关） ─────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── LLM / Embedding 模型服务（改模型只改这里，零代码改动） ─────────────
# 本地 Ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:14b
EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_API_KEY=ollama

# BGE-M3 + Reranker HTTP 服务（Layer 3 服务化架构）
# 设置后所有 worker 通过 HTTP 共享 GPU 模型，消除重复加载。
# 不设置 → 降级本地模型（向后兼容）
EMBEDDING_SERVICE_URL=http://localhost:19500

# 企业 vLLM 部署示例:
# LLM_BASE_URL=http://vllm.internal:8000/v1
# LLM_MODEL=Qwen2.5-72B
# EMBEDDING_MODEL=bge-m3
# LLM_API_KEY=your-key

# DeepSeek 示例:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat        # model_registry 的 model_id（不要填模型名 deepseek-v4-flash）
# EMBEDDING_MODEL=deepseek-embed
# LLM_API_KEY=sk-your-key
# LLM_MAX_TOKENS=8192            # 推理类模型需预留 reasoning token 预算（空输出守卫的根因修复）

# LLM 和 Embedding 不同服务（混合模式）:
# EMBEDDING_BASE_URL=http://localhost:11434
# LLM_BASE_URL=http://vllm.internal:8000/v1

# ── 权限服务（Cerbos） ─────────────────────────────────────────────────
AUTHZ_BASE_URL=http://localhost:13592
AUTHZ_TIMEOUT_MS=2000

# ── OIDC 认证（不配置时自动退回 /dev-login 开发模式） ─────────────────
# 生产环境配置这三个变量，支持 Keycloak / Auth0 / Okta / 企业 IdP
# OIDC_DISCOVERY_URL=https://keycloak.example.com/realms/rag/.well-known/openid-configuration
# OIDC_CLIENT_ID=rag-v14
# OIDC_CLIENT_SECRET=<CHANGE_ME>

# ── CORS 允许来源（逗号分隔，生产必须配置为具体域名） ─────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# ── OTel Collector ────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Langfuse ──────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=<CHANGE_ME>
LANGFUSE_SECRET_KEY=<CHANGE_ME>
LANGFUSE_HOST=http://localhost:13000

# ── 前端外部链接（浏览器通过局域网 / 公网 IP 访问，默认回退到后端地址） ──
GRAFANA_URL=http://localhost:3000
LANGFUSE_PUBLIC_URL=http://localhost:13000
CERBOS_PUBLIC_URL=http://localhost:13592
ADMIN_CONSOLE_URL=

# ── 本地开发：基础设施连接地址 ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rag:${POSTGRES_PASSWORD}@localhost:25432/rag
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:16379/0
MILVUS_HOST=localhost
MILVUS_PORT=19530
S3_ENDPOINT_URL=http://localhost:18333
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-files
PIPELINE_YAML_DIR=./pipelines
LOG_LEVEL=INFO

# ── JWT JWKS（生产环境从 IdP 自动获取公钥，取代本地 PEM 文件） ──────────
# JWT_JWKS_URL=https://keycloak.example.com/realms/rag/protocol/openid-connect/certs

# ── 开发期本地文档目录（生产环境为空，跳过本地文件 fallback） ──────────
DEV_DOCS_DIR=./test_docs
